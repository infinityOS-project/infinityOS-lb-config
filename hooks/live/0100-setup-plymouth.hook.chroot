#!/bin/sh
set -e

echo "Setting Sunshine Plymouth theme..."

# 1. Register the sunshine theme
update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth /usr/share/plymouth/themes/sunshine/sunshine.plymouth 500

# 2. Set sunshine as the default and rebuild the initramfs
# Using -R is the shortcut to rebuild the boot image automatically
plymouth-set-default-theme -R sunshine
