#!/bin/bash
set -e

# Remove default Debian/GNOME wallpapers
rm -rf /usr/share/backgrounds/gnome/

# Remove their XML descriptors from background picker
rm -f /usr/share/gnome-background-properties/adwaita.xml
rm -f /usr/share/gnome-background-properties/gnome-background-properties.xml
rm -f /usr/share/gnome-background-properties/debian*.xml
