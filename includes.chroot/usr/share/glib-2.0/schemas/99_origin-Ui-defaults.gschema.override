[org.gnome.desktop.interface]
icon-theme='Radience'

[org.gnome.shell]
enabled-extensions=['dash-to-panel-esteros@gnome-shell-extensions.esterdev.github.com', 'arcmenu@arcmenu-originUi.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'Origin@appscreen', 'OriginUICC@quandz24.extension', 'OriginUIPrivateMode@quandz24.extension']
disable-user-extensions=false

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/sedona/main.png'
picture-uri-dark='file:///usr/share/backgrounds/sedona/main.png'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/sedona/main.png'

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'

[org.gnome.shell.extensions.arcmenu]
activate-on-launch=false
apps-show-extra-details=false
arcmenu-hotkey=['Super_L']
arcmenu-hotkey-overlay-key-enabled=true
button-item-icon-size='Default'
category-icon-type='Full_Color'
dash-to-panel-standalone=false
disable-scrollview-fade-effect=false
enable-clock-widget-unity=false
enable-unity-homescreen=false
enable-weather-widget-unity=false
force-menu-location='MonitorCentered'
group-apps-alphabetically-grid-layouts=false
group-apps-alphabetically-list-layouts=true
hotkey-open-primary-monitor=false
left-panel-width=540
menu-background-color='rgba(48,48,49,0.98)'
menu-border-color='rgb(60,60,60)'
menu-button-appearance='Icon'
menu-button-border-radius=(false, 25)
menu-button-fg-color=(false, 'rgb(242,242,242)')
menu-button-hover-bg-color=(true, 'rgb(255,4,64)')
menu-button-icon-size=23
menu-button-padding=10
menu-button-position-offset=10
menu-button-text='ester'
menu-foreground-color='rgb(223,223,223)'
menu-height=500
menu-item-active-bg-color='rgb(25,98,163)'
menu-item-active-fg-color='rgb(255,255,255)'
menu-item-hover-bg-color='rgb(21,83,158)'
menu-item-hover-fg-color='rgb(255,255,255)'
menu-layout='Elementary'
menu-separator-color='rgba(255,255,255,0.1)'
multi-monitor=false
override-menu-theme=false
position-in-panel='Left'
prefs-visible-page=0
right-panel-width=305
search-entry-border-radius=(true, 25)
searchbar-default-top-location='Top'
shortcut-icon-type='Full_Color'
show-activities-button=false
show-category-sub-menus=false
show-hidden-recent-files=true

# Dash to Panel Settings - Complete
[org.gnome.shell.extensions.dash-to-panel]
animate-appicon-hover=false
animate-appicon-hover-animation-convexity={'RIPPLE': 2.0, 'PLANK': 1.0, 'SIMPLE': 0.0}
animate-appicon-hover-animation-extent={'RIPPLE': 4, 'PLANK': 4, 'SIMPLE': 1}
animate-appicon-hover-animation-travel={'SIMPLE': 0.29999999999999999, 'RIPPLE': 0.40000000000000002, 'PLANK': 0.0}
animate-appicon-hover-animation-type='SIMPLE'
appicon-margin=0
appicon-padding=7
appicon-style='NORMAL'
dot-position='BOTTOM'
dot-style-focused='DASHES'
dot-style-unfocused='DOTS'
focus-highlight=true
global-border-radius=2
group-apps=true
highlight-appicon-hover=true
hotkeys-overlay-combo='TEMPORARILY'
intellihide=false
leftbox-size=0
panel-anchors='{"RHT-0x00000000":"MIDDLE"}'
panel-element-positions='{"RHT-0x00000000":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"centered"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedTL"},{"element":"dateMenu","visible":false,"position":"stackedTL"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":false,"position":"stackedTL"}]}'
panel-lengths='{"RHT-0x00000000":100}'
panel-positions='{"RHT-0x00000000":"BOTTOM"}'
panel-side-margins=24
panel-side-padding=10
panel-sizes='{"RHT-0x00000000":68}'
panel-top-bottom-margins=18
panel-top-bottom-padding=2
progress-show-count=true
show-favorites=true
show-favorites-all-monitors=true
show-running-apps=true
show-tooltip=true
show-window-previews=false
status-icon-padding=-1
stockgs-force-hotcorner=false
stockgs-keep-dash=false
stockgs-keep-top-panel=false
stockgs-panelbtn-click-only=false
trans-border-custom-color='rgb(192,191,188)'
trans-border-use-custom-color=true
trans-border-width=1
trans-gradient-bottom-opacity=0.45000000000000001
trans-gradient-top-opacity=0.59999999999999998
trans-panel-opacity=0.65000000000000002
trans-use-border=true
trans-use-custom-bg=false
trans-use-custom-gradient=false
trans-use-custom-opacity=true
trans-use-dynamic-opacity=false
tray-padding=-1
tray-size=0
window-preview-padding=8
window-preview-title-position='TOP'
